{
  "name": "claude-mods",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-shared.ts",
    "sync:check": "node scripts/sync-shared.ts --check",
    "typecheck": "tsc -p . && tsc -p scripts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "claude plugin test plugins/session-band && claude plugin test plugins/christmas-theme",
    "check": "npm run sync:check && npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=24"
  }
}
